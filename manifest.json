{
  "manifest_version": 3,
  "name": "Enhance X",
  "version": "0.2.0",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Enhance X 設定",
    "default_popup": "popup.html"
  },
  "description": "Xのおすすめ・ニュース欄を隠し、フォロー中のタイムラインに集中できます。",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "css": ["content.css"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
